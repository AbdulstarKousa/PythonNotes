from PIL import Image, ImageOps, ImageEnhance, ImageFilter

def enhance_text(crop, scale=3):
    gray = ImageOps.grayscale(crop)

    # Reduce isolated scan noise
    denoised = gray.filter(ImageFilter.MedianFilter(size=3))

    # Upscale
    enlarged = denoised.resize(
        (denoised.width * scale, denoised.height * scale),
        Image.Resampling.LANCZOS
    )

    # Contrast enhancement
    contrast = ImageOps.autocontrast(enlarged, cutoff=1)

    # Sharpen
    sharpened = contrast.filter(
        ImageFilter.UnsharpMask(
            radius=1.2,
            percent=150,
            threshold=3
        )
    )

    # Binary threshold
    binary = sharpened.point(
        lambda p: 255 if p > 170 else 0
    )

    return {
        "original": crop,
        "grayscale": gray,
        "denoised": denoised,
        "contrast": contrast,
        "sharpened": sharpened,
        "binary": binary,
    }
